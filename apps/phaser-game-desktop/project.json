{
  "name": "phaser-game-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/phaser-game-desktop/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx-electron:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/phaser-game-desktop",
        "main": "apps/phaser-game-desktop/src/main.ts",
        "tsConfig": "apps/phaser-game-desktop/tsconfig.app.json",
        "assets": [
          "apps/phaser-game-desktop/src/assets",
          {
            "input": "apps/phaser-game-desktop",
            "glob": "package.json",
            "output": "/"
          }
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/phaser-game-desktop/src/environments/environment.ts",
              "with": "apps/phaser-game-desktop/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "nx-electron:execute",
      "options": {
        "buildTarget": "phaser-game-desktop:build"
      }
    },
    "package": {
      "executor": "nx-electron:package",
      "options": {
        "name": "phaser-game-desktop",
        "frontendProject": "phaser-game",
        "sourcePath": "dist/apps",
        "outputPath": "dist/packages",
        "prepackageOnly": true
      }
    },
    "make": {
      "executor": "nx-electron:make",
      "options": {
        "name": "phaser-game-desktop",
        "frontendProject": "phaser-game",
        "sourcePath": "dist/apps",
        "outputPath": "dist/executables"
      }
    },
    "lint": {
      "command": "eslint apps/phaser-game-desktop/**/*.ts"
    }
  }
}
