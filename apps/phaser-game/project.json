{
  "name": "phaser-game",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/phaser-game/src-electron",
  "projectType": "application",
  "targets": {
    "build-electron": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/phaser-game",
        "configFile": "apps/phaser-game/vite.main.config.mts"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve-electron": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run phaser-game:build-electron:development"
      }
    },
    "build-game": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/phaser-game/game",
        "configFile": "apps/phaser-game/game/vite.config.mts"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve-game": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "phaser-game:build-game"
      },
      "configurations": {
        "development": {
          "buildTarget": "phaser-game:build-game:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "phaser-game:build-game:production",
          "hmr": false
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run phaser-game:serve-game",
          "nx run phaser-game:serve-electron"
        ],
        "parallel": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run phaser-game:build-game:production",
          "nx run phaser-game:build-electron:production"
        ],
        "parallel": true
      }
    },
    "package": {
      "executor": "nx-electron:package",
      "options": {
        "name": "phaser-game",
        "frontendProject": "phaser-game",
        "sourcePath": "dist/apps",
        "outputPath": "dist/packages",
        "prepackageOnly": true
      }
    },
    "make": {
      "executor": "nx-electron:make",
      "options": {
        "name": "phaser-game",
        "frontendProject": "phaser-game",
        "sourcePath": "dist/apps",
        "outputPath": "dist/executables"
      }
    },
    "lint": {
      "command": "eslint apps/phaser-game/**/*.ts"
    }
  }
}
