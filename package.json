    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsdown": "^0.22.3",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "unrun": "^0.3.1",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^4.1.1",
