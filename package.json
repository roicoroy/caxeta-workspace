{
  "name": "@nestjs-template/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    
    "dev:web": "nx run phaser-game:serve-game",
    "dev:electron": "nx serve phaser-game",
    
    "build:web": "nx run phaser-game:build-game",
    "build:electron": "nx build phaser-game",
    
    "package:electron": "nx run phaser-game:make --prepackageOnly",
    "make:electron": "nx run phaser-game:make",
    
    "cap:sync": "nx run phaser-game:build-game:production && cd apps/phaser-game && npx cap sync",
    "cap:ios": "pnpm run cap:sync && cd apps/phaser-game && npx cap open ios",
    "cap:android": "pnpm run cap:sync && cd apps/phaser-game && npx cap open android",
    
    "test": "nx test phaser-game"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "axios": "^1.6.0",
    "phaser": "^4.2.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "jsdom": "^30.0.1",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.0",
